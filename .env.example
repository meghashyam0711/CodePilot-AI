# ==============================================================================
# CodePilot AI - Environment Configuration Example
# Copy this file to '.env' to override default configuration values.
# Note: For Phase 1, LLM API keys are neither required nor used.
# ==============================================================================

# Project root directory (defaults to current working directory if left blank)
CODEPILOT_PROJECT_ROOT=

# Logging verbosity level: DEBUG, INFO, WARNING, ERROR, CRITICAL
CODEPILOT_LOG_LEVEL=INFO

# AI Model Provider selection (Phase 1: disabled/none; supported in future: openai, anthropic, gemini, ollama)
CODEPILOT_MODEL_PROVIDER=none

# Optional model identifier (e.g. gpt-4o, claude-3-5-sonnet-20241022, gemini-1.5-pro)
CODEPILOT_MODEL_ID=

# HTTP/API request timeout in seconds (must be positive float)
CODEPILOT_REQUEST_TIMEOUT=30.0

# Maximum allowed input size in bytes (must be positive integer)
CODEPILOT_MAX_INPUT_SIZE=100000

# Require explicit developer approval before any code modifications are applied (true/false)
CODEPILOT_REQUIRE_APPROVAL=true

# Comma-separated list of additional protected file patterns (globs)
CODEPILOT_PROTECTED_FILES=.env,.env.*,*.pem,*.key,credentials.json,secrets.*,pyproject.toml

# Comma-separated list of protected directory names
CODEPILOT_PROTECTED_DIRECTORIES=.git,.venv,venv,__pycache__,node_modules,.idea,.vscode,dist,build
